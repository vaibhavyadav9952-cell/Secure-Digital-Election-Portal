# Copy this file to .env and fill in your own values
# NEVER commit the actual .env file

# Flask session signing key — use a long random string
FLASK_SECRET_KEY=change_me_to_a_long_random_string

# AES-256 master key for encrypting blockchain ballots (min 32 chars)
BALLOT_MASTER_KEY=change_me_to_32_char_secret_key_here

# HMAC salt for anonymising voter IDs in the blockchain
VOTER_HMAC_SALT=change_me_to_another_random_salt
